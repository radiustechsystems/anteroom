# build artifacts
/anteroom
/var/
/dist/
*.test
coverage.out
node_modules/
test-results/
anteroom-payments.db

# local env & secrets — never commit
.env
.env.*
*.key
anteroom.toml
# ...except an example deployment's, which is committed on purpose: it is what
# the acceptance suite deploys and what compose bind-mounts into the gate.
# Without this line the pattern above swallows it, `docker compose up` creates a
# directory where the file should be, and the container fails to start with
# "not a directory".
!examples/*/anteroom.toml
# ...and the benchmark stack's, for the same reason (bench/compose.yaml
# bind-mounts it). anteroom.noinject.toml is not caught by the pattern.
!bench/anteroom.toml
log/
run

# editor / OS noise
.DS_Store
*~
.*~

# example deployment secrets
examples/anteroomized/.env

# benchmark stack: its key, its results, and local policy variants
bench/.env
bench/results/*
!bench/results/.gitkeep
bench/local/
