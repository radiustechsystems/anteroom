# build artifacts
/anteroom
/var/
/dist/
*.test
coverage.out
node_modules/
test-results/
anteroom-payments.db

# local env & secrets — never commit
.env
.env.*
*.key
anteroom.toml
# ...except the reference deployment's, which is committed on purpose: it is
# what the acceptance suite deploys, and compose bind-mounts it into the gate.
# Without this line the pattern above swallows it, `docker compose up` creates a
# directory where the file should be, and the container fails to start with
# "not a directory".
!examples/anteroomized/anteroom.toml
log/
run

# editor / OS noise
.DS_Store
*~
.*~

# example deployment secrets
examples/anteroomized/.env
